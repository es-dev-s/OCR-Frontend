# Base URL of the Go API.
# NEXT_PUBLIC_* is inlined at build time — changing it requires a redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional OCR workers health URL (Railway). Not used for document uploads —
# workers consume Redis Streams. Leave empty if unused.
NEXT_PUBLIC_OCR_ENGINE_URL=

# PDF Extract API (title / text). Server-only — never NEXT_PUBLIC_*.
# Used by app/api/pdf/* route handlers; key must not ship to the browser.
# Railway production title detector (or local http://127.0.0.1:8000).
PDF_API_URL=https://web-production-05065.up.railway.app
PDF_API_KEY=dev-pdf-extract-key-change-me
